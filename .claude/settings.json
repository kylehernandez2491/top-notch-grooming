{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./api/local.settings.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(az *)",
      "Bash(gh secret *)",
      "Bash(git push)",
      "Bash(git push *)"
    ]
  }
}
